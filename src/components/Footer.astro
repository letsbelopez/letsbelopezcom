---
const today = new Date();
import SocialLinks from './SocialLinks.astro';
---

<footer class="mt-20 border-t border-[rgba(43,38,31,0.08)] bg-[rgba(247,241,232,0.8)]">
	<div class="mx-auto flex w-full max-w-5xl flex-col items-center gap-4 px-4 py-12 text-center text-sm text-[color:var(--muted)]">
		<p class="font-mono tracking-[0.2em] uppercase">© {today.getFullYear()} David Lopez. All rights reserved.</p>
		<SocialLinks
			class="flex items-center gap-3"
			linkClass="rounded-full p-2 text-[color:var(--muted)] transition hover:text-[color:var(--accent)] hover:bg-[rgba(224,122,95,0.12)]"
		/>
	</div>
</footer>
