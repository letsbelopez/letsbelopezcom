<section class="daylight-toy" data-daylight-toy aria-labelledby="daylight-title">
	<header class="daylight-intro">
		<div class="daylight-title">
			<p class="kicker">Kin / Build</p>
			<h1 id="daylight-title">Daylight Toy</h1>
			<p>A small globe for seeing day and night.</p>
		</div>

		<div class="daylight-status" aria-live="polite" aria-atomic="true">
			<span class="status-dot" data-state-dot></span>
			<span data-state-label>Daytime</span>
		</div>
	</header>

	<div
		class="daylight-stage"
		data-stage
		tabindex="0"
		role="group"
		aria-describedby="daylight-help"
	>
		<canvas data-canvas aria-hidden="true"></canvas>

		<div class="daylight-controls" aria-label="Globe controls">
			<button type="button" data-rotate="-1" aria-label="Spin globe left" title="Spin globe left">
				&larr;
			</button>
			<button type="button" data-reset aria-label="Reset globe" title="Reset globe">Reset</button>
			<button type="button" data-rotate="1" aria-label="Spin globe right" title="Spin globe right">
				&rarr;
			</button>
		</div>

		<p id="daylight-help" class="sr-only">
			Drag left or right on the globe, or use the left and right arrow keys, to rotate Earth.
		</p>
	</div>
</section>

<script>
	import {
		BackSide,
		BufferGeometry,
		CanvasTexture,
		DirectionalLight,
		Group,
		HemisphereLight,
		Line,
		LineBasicMaterial,
		Mesh,
		MeshBasicMaterial,
		MeshStandardMaterial,
		Object3D,
		PerspectiveCamera,
		Scene,
		SphereGeometry,
		SRGBColorSpace,
		TorusGeometry,
		Vector3,
		WebGLRenderer,
	} from 'three';

	const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

	document.querySelectorAll('[data-daylight-toy]').forEach((root) => {
		if (!(root instanceof HTMLElement) || root.dataset.ready === 'true') return;
		root.dataset.ready = 'true';

		const stage = root.querySelector('[data-stage]');
		const canvas = root.querySelector('[data-canvas]');
		const stateLabel = root.querySelector('[data-state-label]');
		const stateDot = root.querySelector('[data-state-dot]');
		const resetButton = root.querySelector('[data-reset]');
		const rotateButtons = root.querySelectorAll('[data-rotate]');

		if (
			!(stage instanceof HTMLElement) ||
			!(canvas instanceof HTMLCanvasElement) ||
			!(stateLabel instanceof HTMLElement) ||
			!(stateDot instanceof HTMLElement) ||
			!(resetButton instanceof HTMLButtonElement)
		) {
			return;
		}

		const renderer = new WebGLRenderer({
			canvas,
			antialias: true,
			alpha: true,
			powerPreference: 'high-performance',
		});
		renderer.outputColorSpace = SRGBColorSpace;
		renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

		const scene = new Scene();
		const camera = new PerspectiveCamera(38, 1, 0.1, 100);
		const earthRoot = new Group();
		const sunPosition = new Vector3(-3.2, 1.15, 0.2);
		const sunTarget = new Object3D();
		const homeNormal = new Vector3(-0.44, 0.15, 0.89).normalize();
		const yAxis = new Vector3(0, 1, 0);

		scene.add(earthRoot);
		scene.add(sunTarget);
		scene.add(new HemisphereLight(0xc9e6f0, 0x14242f, 0.54));

		const sunLight = new DirectionalLight(0xfff4d0, 3.8);
		sunLight.target = sunTarget;
		scene.add(sunLight);

		const sunGroup = createSun();
		scene.add(sunGroup);
		createLightRays().forEach((ray) => scene.add(ray));

		const earthTexture = new CanvasTexture(createEarthTexture());
		earthTexture.colorSpace = SRGBColorSpace;
		earthTexture.anisotropy = renderer.capabilities.getMaxAnisotropy();

		const earth = new Mesh(
			new SphereGeometry(1.28, 96, 64),
			new MeshStandardMaterial({
				map: earthTexture,
				roughness: 0.9,
				metalness: 0,
			})
		);
		earthRoot.add(earth);

		const atmosphere = new Mesh(
			new SphereGeometry(1.32, 96, 64),
			new MeshBasicMaterial({
				color: 0x9fd6e0,
				transparent: true,
				opacity: 0.18,
				side: BackSide,
			})
		);
		earthRoot.add(atmosphere);
		earthRoot.add(createHomeMarker(homeNormal));

		let targetRotation = 0;
		let currentRotation = 0;
		let previousLight = 1;
		let phase = 'Daytime';
		let dragging = false;
		let pointerStartX = 0;
		let rotationStart = 0;

		const resizeObserver = new ResizeObserver(resize);
		resizeObserver.observe(stage);
		resize();
		animate();

		canvas.addEventListener('pointerdown', (event) => {
			dragging = true;
			pointerStartX = event.clientX;
			rotationStart = targetRotation;
			canvas.setPointerCapture(event.pointerId);
			stage.focus({ preventScroll: true });
			root.classList.add('is-dragging');
		});

		canvas.addEventListener('pointermove', (event) => {
			if (!dragging) return;
			targetRotation = rotationStart + (event.clientX - pointerStartX) * 0.012;
		});

		canvas.addEventListener('pointerup', stopDragging);
		canvas.addEventListener('pointercancel', stopDragging);

		stage.addEventListener('keydown', (event) => {
			if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
			event.preventDefault();
			targetRotation += event.key === 'ArrowLeft' ? -0.42 : 0.42;
		});

		rotateButtons.forEach((button) => {
			if (!(button instanceof HTMLButtonElement)) return;
			button.addEventListener('click', () => {
				targetRotation += Number(button.dataset.rotate) * 0.5;
				stage.focus({ preventScroll: true });
			});
		});

		resetButton.addEventListener('click', () => {
			targetRotation = 0;
			stage.focus({ preventScroll: true });
		});

		function stopDragging(event) {
			if (!dragging) return;
			dragging = false;
			root.classList.remove('is-dragging');
			if (event?.pointerId !== undefined && canvas.hasPointerCapture(event.pointerId)) {
				canvas.releasePointerCapture(event.pointerId);
			}
		}

		function resize() {
			const rect = stage.getBoundingClientRect();
			const width = Math.max(1, Math.round(rect.width));
			const height = Math.max(1, Math.round(rect.height));
			const compact = width < 680;

			renderer.setSize(width, height, false);
			camera.aspect = width / height;
			camera.position.set(0, compact ? 0.12 : 0.08, compact ? 6.7 : 5.6);
			camera.lookAt(0, 0, 0);
			camera.updateProjectionMatrix();

			earthRoot.position.set(compact ? 0.26 : 0.62, compact ? -0.2 : -0.04, 0);
			earthRoot.scale.setScalar(compact ? 0.9 : 1);
			sunPosition.set(compact ? -1.72 : -3.1, compact ? 1.18 : 1.08, compact ? 0.1 : 0.2);
			sunGroup.position.copy(sunPosition);
			sunGroup.scale.setScalar(compact ? 0.86 : 1);
			sunLight.position.copy(sunPosition);
			sunTarget.position.copy(earthRoot.position);
		}

		function animate() {
			const reduced = prefersReducedMotion.matches;
			currentRotation = reduced
				? targetRotation
				: currentRotation + (targetRotation - currentRotation) * 0.16;
			earthRoot.rotation.y = currentRotation;
			updatePhase();
			renderer.render(scene, camera);
			requestAnimationFrame(animate);
		}

		function updatePhase() {
			const worldHomeNormal = homeNormal.clone().applyAxisAngle(yAxis, currentRotation);
			const sunDirection = sunPosition.clone().sub(earthRoot.position).normalize();
			const light = worldHomeNormal.dot(sunDirection);
			const nextPhase = getPhase(light, previousLight);

			if (nextPhase !== phase) {
				phase = nextPhase;
				stateLabel.textContent = phase;
				root.dataset.phase = phase.toLowerCase();
				stateDot.dataset.phase = phase.toLowerCase();
			}

			previousLight = light;
		}

		function getPhase(light, lastLight) {
			if (light > 0.24) return 'Daytime';
			if (light < -0.24) return 'Nighttime';
			return light >= lastLight ? 'Sunrise' : 'Sunset';
		}

		function createSun() {
			const group = new Group();
			const sun = new Mesh(
				new SphereGeometry(0.43, 64, 32),
				new MeshBasicMaterial({ color: 0xffc84d })
			);
			const glow = new Mesh(
				new SphereGeometry(0.64, 64, 32),
				new MeshBasicMaterial({
					color: 0xffd879,
					transparent: true,
					opacity: 0.22,
					depthWrite: false,
				})
			);
			group.add(glow, sun);
			group.position.copy(sunPosition);
			return group;
		}

		function createLightRays() {
			const rayMaterial = new LineBasicMaterial({
				color: 0xf7c95d,
				transparent: true,
				opacity: 0.5,
			});

			return [-0.44, 0, 0.44].map((offset) => {
				const geometry = new BufferGeometry().setFromPoints([
					new Vector3(-2.72, 1.02 + offset * 0.48, 0.02),
					new Vector3(-0.72, 0.13 + offset, 0.02),
				]);
				return new Line(geometry, rayMaterial);
			});
		}

		function createHomeMarker(normal) {
			const group = new Group();
			group.position.copy(normal.clone().multiplyScalar(1.34));
			group.quaternion.setFromUnitVectors(new Vector3(0, 0, 1), normal);

			const ring = new Mesh(
				new TorusGeometry(0.115, 0.011, 12, 42),
				new MeshBasicMaterial({ color: 0xfaf3e6 })
			);
			const dot = new Mesh(
				new SphereGeometry(0.055, 24, 16),
				new MeshBasicMaterial({ color: 0xe24a35 })
			);
			dot.position.z = 0.03;
			group.add(ring, dot);
			return group;
		}
	});

	function createEarthTexture() {
		const canvas = document.createElement('canvas');
		canvas.width = 1024;
		canvas.height = 512;
		const context = canvas.getContext('2d');

		if (!context) return canvas;

		const ocean = context.createLinearGradient(0, 0, canvas.width, canvas.height);
		ocean.addColorStop(0, '#2c86a8');
		ocean.addColorStop(0.52, '#24739d');
		ocean.addColorStop(1, '#185b83');
		context.fillStyle = ocean;
		context.fillRect(0, 0, canvas.width, canvas.height);

		context.strokeStyle = 'rgba(255, 255, 255, 0.14)';
		context.lineWidth = 1;
		for (let x = 0; x <= canvas.width; x += 128) {
			context.beginPath();
			context.moveTo(x, 0);
			context.lineTo(x, canvas.height);
			context.stroke();
		}
		for (let y = 64; y < canvas.height; y += 96) {
			context.beginPath();
			context.moveTo(0, y);
			context.lineTo(canvas.width, y);
			context.stroke();
		}

		drawBlob(context, '#4f8b5f', [
			[138, 142],
			[242, 116],
			[316, 172],
			[294, 260],
			[206, 294],
			[126, 238],
		]);
		drawBlob(context, '#5b965f', [
			[346, 268],
			[414, 280],
			[446, 366],
			[396, 446],
			[338, 384],
		]);
		drawBlob(context, '#6aa16a', [
			[514, 142],
			[652, 118],
			[724, 188],
			[682, 264],
			[552, 250],
		]);
		drawBlob(context, '#4f8b5f', [
			[640, 280],
			[734, 264],
			[812, 330],
			[776, 426],
			[676, 410],
		]);
		drawBlob(context, '#6fa66d', [
			[820, 132],
			[944, 154],
			[972, 238],
			[878, 278],
			[802, 224],
		]);

		context.fillStyle = 'rgba(255, 255, 255, 0.72)';
		context.fillRect(0, 0, canvas.width, 28);
		context.fillRect(0, canvas.height - 28, canvas.width, 28);

		context.fillStyle = 'rgba(255, 255, 255, 0.38)';
		drawCloud(context, 90, 96, 210, 24);
		drawCloud(context, 420, 82, 180, 18);
		drawCloud(context, 668, 214, 240, 22);
		drawCloud(context, 174, 352, 190, 18);
		drawCloud(context, 766, 390, 210, 20);

		return canvas;
	}

	function drawBlob(context, color, points) {
		context.fillStyle = color;
		context.beginPath();
		context.moveTo(points[0][0], points[0][1]);
		for (let index = 1; index < points.length; index += 1) {
			const [x, y] = points[index];
			const [previousX, previousY] = points[index - 1];
			context.quadraticCurveTo(previousX, previousY, x, y);
		}
		context.quadraticCurveTo(
			points[points.length - 1][0],
			points[points.length - 1][1],
			points[0][0],
			points[0][1]
		);
		context.fill();
	}

	function drawCloud(context, x, y, width, height) {
		context.beginPath();
		context.ellipse(x, y, width * 0.38, height, -0.08, 0, Math.PI * 2);
		context.ellipse(x + width * 0.34, y + height * 0.18, width * 0.32, height * 0.82, 0.05, 0, Math.PI * 2);
		context.ellipse(x + width * 0.62, y - height * 0.08, width * 0.24, height * 0.72, -0.04, 0, Math.PI * 2);
		context.fill();
	}
</script>

<style>
	.daylight-toy {
		margin: 0;
	}

	.daylight-intro {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: end;
		gap: 1.5rem;
		width: min(100% - 2rem, 64rem);
		margin: 0 auto;
		padding: clamp(2rem, 5vw, 4rem) 0 1.25rem;
	}

	.daylight-stage {
		position: relative;
		min-height: clamp(34rem, 78svh, 46rem);
		overflow: hidden;
		border-block: 1px solid var(--rule);
		background:
			linear-gradient(145deg, #fbf5e8 0%, #e8eadb 34%, #c6dee2 68%, #9cb9ca 100%);
		cursor: grab;
		touch-action: none;
	}

	.daylight-toy.is-dragging .daylight-stage {
		cursor: grabbing;
	}

	.daylight-stage canvas {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		display: block;
	}

	.daylight-status,
	.daylight-controls {
		border: 1px solid rgb(var(--ink-rgb) / 0.12);
		border-radius: 8px;
		background: rgb(248 244 236 / 0.78);
		backdrop-filter: blur(14px);
		box-shadow: 0 18px 40px rgb(var(--ink-rgb) / 0.12);
	}

	.daylight-title {
		max-width: 28rem;
	}

	.daylight-title .kicker {
		margin: 0 0 0.35rem;
		font-family: var(--font-mono);
		font-size: 0.7rem;
		line-height: 1.2;
		text-transform: uppercase;
		color: var(--accent);
	}

	.daylight-title h1 {
		margin: 0;
		font-size: clamp(2.8rem, 7vw, 5rem);
		font-weight: 500;
		line-height: 0.95;
	}

	.daylight-title p:last-child {
		margin: 0.65rem 0 0;
		max-width: 21rem;
		font-size: clamp(0.95rem, 2vw, 1.08rem);
		line-height: 1.45;
		color: var(--muted);
	}

	.daylight-status {
		display: inline-flex;
		align-items: center;
		justify-self: end;
		gap: 0.55rem;
		padding: 0.72rem 0.88rem;
		font-family: var(--font-mono);
		font-size: 0.76rem;
		line-height: 1;
		text-transform: uppercase;
	}

	.status-dot {
		width: 0.7rem;
		height: 0.7rem;
		border-radius: 999px;
		background: #f0bc42;
		box-shadow: 0 0 0 4px rgb(240 188 66 / 0.2);
	}

	.status-dot[data-phase='nighttime'] {
		background: #3d688f;
		box-shadow: 0 0 0 4px rgb(61 104 143 / 0.2);
	}

	.status-dot[data-phase='sunrise'],
	.status-dot[data-phase='sunset'] {
		background: #d97745;
		box-shadow: 0 0 0 4px rgb(217 119 69 / 0.2);
	}

	.daylight-controls {
		position: absolute;
		z-index: 2;
		left: 50%;
		bottom: clamp(1rem, 4vw, 2rem);
		display: inline-flex;
		gap: 0.35rem;
		padding: 0.35rem;
		transform: translateX(-50%);
	}

	.daylight-controls button {
		min-width: 3rem;
		height: 2.8rem;
		border: 0;
		border-radius: 6px;
		background: transparent;
		color: var(--ink);
		font: inherit;
		font-size: 1rem;
		line-height: 1;
		cursor: pointer;
		transition:
			background-color 160ms ease,
			color 160ms ease,
			transform 160ms ease;
	}

	.daylight-controls button:hover {
		background: rgb(var(--accent-rgb) / 0.12);
		color: var(--accent);
	}

	.daylight-controls button:active {
		transform: translateY(1px);
	}

	@media (max-width: 44rem) {
		.daylight-intro {
			grid-template-columns: 1fr;
			align-items: start;
			padding-top: 2rem;
		}

		.daylight-stage {
			min-height: 42rem;
		}

		.daylight-status {
			justify-self: start;
			max-width: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.daylight-controls button {
			transition: none;
		}
	}
</style>
