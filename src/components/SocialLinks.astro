---
const {
	class: className = 'flex items-center gap-3',
	linkClass = 'text-[color:var(--muted)] transition hover:text-[color:var(--accent)]',
	size = 20,
} = Astro.props;

const links = [
	{
		href: 'https://x.com/letsbelopez',
		label: 'Follow me on X',
		icon: (size) => `
			<svg
				width="${size}"
				height="${size}"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true"
			>
				<path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
				<path d="M4 4l11.733 16h4.267l-11.733 -16z"></path>
				<path d="M4 20l6.768 -6.768m2.46 -2.46l6.772 -6.772"></path>
			</svg>
		`,
	},
	{
		href: 'https://github.com/letsbelopez',
		label: 'Go to my GitHub profile',
		icon: (size) => `
			<svg viewBox="0 0 16 16" aria-hidden="true" width="${size}" height="${size}">
				<path
					fill="currentColor"
					d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
				></path>
			</svg>
		`,
	},
];
---

<div class={className}>
	{links.map((link) => (
		<a class={linkClass} href={link.href} target="_blank" rel="noreferrer">
			<span class="sr-only">{link.label}</span>
			<Fragment set:html={link.icon(size)} />
		</a>
	))}
</div>
